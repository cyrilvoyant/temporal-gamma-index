:software a wsem:Software, schema:SoftwareSourceCode ;
    schema:name "The γ-index: tolerance-based validation of spatio-temporal forecast fields (MATLAB)" ;
    schema:codeRepository <https://github.com/cyrilvoyant/temporal-gamma-index> ;
    wsem:conceptDOI "https://doi.org/10.5281/zenodo.21755936" ;
    schema:identifier <https://doi.org/10.5281/zenodo.21755936> ;
    schema:license "MIT" ;
    schema:programmingLanguage "MATLAB" ;
    schema:description "Accepts a forecast point when an observation agrees within joint tolerances in space (DTA), time (TTA) and intensity (IDT)." ;
    schema:author <https://orcid.org/0000-0003-0242-7377> ;
    schema:citation <https://doi.org/10.1016/j.ijforecast.2026.03.002> ;
    wsem:declaresParameter :in0 ;
